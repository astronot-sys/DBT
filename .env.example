# Copy to .env and edit. Source = your restored SQL Server database.
# Use a SQL Server login (user + password); Windows authentication is not supported here.
MSSQL_HOST=localhost
MSSQL_PORT=1433
MSSQL_USER=sa
MSSQL_PASSWORD=change-me
MSSQL_DB=YourDatabaseName
SOURCE_SCHEMAS=dbo

# Optional MySQL connection for scripts/test_db_connections.py
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=your_mysql_user
MYSQL_PASSWORD=change-me
MYSQL_DB=your_mysql_database

# Postgres from docker-compose.yml (defaults already match)
PG_HOST=localhost
PG_PORT=5432
PG_USER=demo
PG_PASSWORD=demo
PG_DB=demo

# Data lake target. A local folder by default.
LAKE_URI=./lake
# For an S3-compatible store instead:
# LAKE_URI=s3://my-bucket/lake
# S3_ENDPOINT=https://s3.example.com
# S3_ACCESS_KEY=...
# S3_SECRET_KEY=...
